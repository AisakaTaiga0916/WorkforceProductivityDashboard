generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client/primary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_PRIMARY")
}

enum TicketCategory {
  IT
  HR
  FINANCE
  OPERATIONS
  GENERAL
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  UNSET
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_INFO
  ESCALATED
  FOR_CONFIRMATION
  RESOLVED
  CLOSED
}

enum EscalationType {
  FUNCTIONAL
  HIERARCHICAL
}

enum ActivityActor {
  SYSTEM
  AGENT
  USER
}

enum KpiFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  YEARLY
}

enum TaskStatus {
  CURRENT
  PENDING_VERIFICATION
  DONE
  DELAYED
}

/// How delay penalty rate accrues after the due date (ceil buckets for WEEKLY/MONTHLY).
enum DelayPenaltyFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model PortalAccount {
  id                        String                 @id @default(cuid())
  username                  String?                @unique @map("username")
  email                     String                 @unique @map("email")
  name                      String                 @map("name")
  // Deprecated: credentials live in Auth DB / merged_users. Kept for migration only.
  passwordHash              String?                @map("password_hash")
  // Source-of-truth link to Auth DB User.id (logical cross-database reference).
  authUserId                String?                @unique @map("auth_user_id")
  // Deprecated: OAuth linkage now stored on auth_accounts. Kept for migration only.
  oauthProvider             String?                @map("oauth_provider")
  oauthSubject              String?                @map("oauth_subject")
  emailVerifiedAt           DateTime?              @map("email_verified_at")
  // Logical FK to merged_users.source_user_id (HRIS).
  mergedSourceUserId        BigInt?                @unique @map("merged_source_user_id")
  role                      String                 @default("Customer") @map("role")
  headPrivileges            Boolean                @default(false) @map("head_privileges")
  companyId                 String?                @map("company_id")
  company                   Team?                  @relation("PortalCustomerCompany", fields: [companyId], references: [id], onDelete: SetNull)
  staffDesignatedCompanyId  String?                @map("staff_designated_company_id")
  staffDesignatedCompany    Team?                  @relation("PortalStaffDesignatedCompany", fields: [staffDesignatedCompanyId], references: [id], onDelete: SetNull)
  staffAssignmentColor      String?                @map("staff_assignment_color")
  customerOrgRole           String?                @map("customer_org_role")
  accountStatus             String                 @default("ACTIVE") @map("account_status")
  profileImage              String?                @map("profile_image")
  profileImageZoom          Float                  @default(1) @map("profile_image_zoom")
  profileImagePosX          Int                    @default(50) @map("profile_image_pos_x")
  profileImagePosY          Int                    @default(50) @map("profile_image_pos_y")
  profileSyncedAt           DateTime?              @map("profile_synced_at")
  primaryPositionId         String?                @map("primary_position_id")
  primaryPosition           Position?              @relation("PortalPrimaryPosition", fields: [primaryPositionId], references: [id], onDelete: SetNull)
  departmentId              String?                @map("department_id")
  department                Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reportsToPortalAccountId  String?                @map("reports_to_portal_account_id")
  reportsToPortalAccount    PortalAccount?         @relation("PortalReportsTo", fields: [reportsToPortalAccountId], references: [id], onDelete: SetNull)
  directReports             PortalAccount[]        @relation("PortalReportsTo")
  createdAt                 DateTime               @default(now()) @map("created_at")
  /// Staff notifications bell: items with `at` after this timestamp count as unread.
  notificationsLastReadAt   DateTime?              @map("notifications_last_read_at")
  actionRequests            AccountActionRequest[]
  usernameAliases           PortalUsernameAlias[]
  mergeMapping              PortalMergeMapping?

  @@index([authUserId])
  @@index([primaryPositionId])
  @@index([departmentId])
  @@index([reportsToPortalAccountId])
  @@map("portal_accounts")
}

/// Alternate login usernames (e.g. legacy portal username before HRIS merge).
model PortalUsernameAlias {
  id              String        @id @default(cuid())
  portalAccountId String        @map("portal_account_id")
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  username        String        @unique @map("username")
  source          String        @default("legacy") @map("source")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([portalAccountId], map: "idx_portal_username_aliases_portal")
  @@map("portal_username_aliases")
}

/// Explicit PortalAccount ↔ merged_users.source_user_id mapping + legacy identifiers.
model PortalMergeMapping {
  portalAccountId    String        @id @map("portal_account_id")
  portalAccount      PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  mergedSourceUserId BigInt        @unique @map("merged_source_user_id")
  legacyPortalEmail  String?       @map("legacy_portal_email")
  legacyUsername     String?       @map("legacy_username")
  lastSyncedAt       DateTime?     @map("last_synced_at")

  @@index([mergedSourceUserId], map: "idx_portal_merge_mappings_merged_id")
  @@map("portal_merge_mappings")
}

model Team {
  id                            String         @id @default(cuid())
  name                          String         @map("name")
  description                   String?        @map("description")
  /// Relative HRIS path (e.g. company-logos/….png) synced from merged_companies.
  logoPath                      String?        @map("logo_path")
  /// Optional inlined logo data URL for UI (from HRIS company logo file).
  logoImage                     String?        @map("logo_image") @db.Text
  /// HRIS companies.id when known.
  hrisCompanyId                 BigInt?        @unique @map("hris_company_id")
  createdAt                     DateTime       @default(now()) @map("created_at")
  agents                        Agent[]
  tickets                       Ticket[]
  customerPortalAccounts        PortalAccount[] @relation("PortalCustomerCompany")
  staffDesignatedPortalAccounts PortalAccount[] @relation("PortalStaffDesignatedCompany")
  departments                 Department[]
  positionAssignments         PositionAssignment[]
  orgChartSections            OrgChartSection[]

  @@map("teams")
}

model Agent {
  id        String   @id @default(cuid())
  name      String   @map("name")
  email     String   @unique @map("email")
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tickets   Ticket[] @relation("AssignedAgent")
  kpis      KpiMaintenance[] @relation("AssignedKpi")
  tasks     TaskItem[]       @relation("AssignedTask")
  kpiCompletionVerifierFor KpiMaintenance[] @relation("KpiCompletionVerifier")
  kpiCompletionVerifiedBy  KpiMaintenance[] @relation("KpiCompletionVerifiedBy")
  approvedTravelOrders TravelOrder[] @relation("TravelOrderApprover")
  confirmedTravelOrders TravelOrder[] @relation("TravelOrderConfirmer")
  createdTravelOrders TravelOrder[] @relation("TravelOrderCreator")
  driverTravelOrders TravelOrder[] @relation("TravelOrderDriver")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([teamId, name])
  @@map("agents")
}

model SlaPolicy {
  id                 String         @id @default(cuid())
  priority           TicketPriority @unique @map("priority")
  firstResponseHours Float          @map("first_response_hours")
  resolutionHours    Float          @map("resolution_hours")

  @@map("sla_policies")
}

model EscalationTrigger {
  id           String         @id @default(cuid())
  priority     TicketPriority @unique @map("priority")
  enabled      Boolean        @default(false) @map("enabled")
  notifyAdmin  Boolean        @default(false) @map("notify_admin")
  notifyTarget String         @default("NONE") @map("notify_target")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("escalation_triggers")
}

/// Organizational chart node. People only: every node is a staff member from the
/// roster (MergedUser in the secondary DB), snapshotted so the chart survives roster drift.
model OrgChartNode {
  id                  String         @id @default(cuid())
  parentId            String?        @map("parent_id")
  parent              OrgChartNode?  @relation("OrgChartHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children            OrgChartNode[] @relation("OrgChartHierarchy")
  sortOrder           Int            @default(0) @map("sort_order")
  /// Roster person id (MergedUser.sourceUserId) this node represents.
  mergedSourceUserId  String         @unique @map("merged_source_user_id")
  personName          String         @map("person_name")
  personRole          String?        @map("person_role")
  companyName         String?        @map("company_name")
  primaryPositionId   String?        @map("primary_position_id")
  primaryPosition     Position?      @relation("OrgChartPrimaryPosition", fields: [primaryPositionId], references: [id], onDelete: SetNull)
  /// Optional labeled section grouping (alongside reports-to hierarchy).
  sectionId           String?        @map("section_id")
  section             OrgChartSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sectionMemberships  OrgChartNodeSectionMembership[]
  headedSections      OrgChartSection[] @relation("OrgChartSectionHead")
  /// Departments that report directly to this person (alongside section nesting).
  reportedDepartments OrgChartSection[] @relation("OrgChartSectionReportsTo")
  eitherOrAsA         OrgChartEitherOrLink[] @relation("EitherOrNodeA")
  eitherOrAsB         OrgChartEitherOrLink[] @relation("EitherOrNodeB")
  /// When set, this person reports to a shared either/or manager pair (layout parentId is one peer).
  parentEitherOrLinkId String?              @map("parent_either_or_link_id")
  parentEitherOrLink   OrgChartEitherOrLink? @relation("EitherOrChildren", fields: [parentEitherOrLinkId], references: [id], onDelete: SetNull)
  /// When true, reports-to cannot be changed (drag, dropdown, or bulk) until unlocked.
  parentLocked         Boolean              @default(false) @map("parent_locked")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([parentId, sortOrder])
  @@index([primaryPositionId])
  @@index([sectionId])
  @@index([parentEitherOrLinkId])
  @@map("org_chart_nodes")
}

/// Undirected either/or link between two org-chart people.
/// Approvals that hit either node may be satisfied by either linked person.
/// Children may hang under the pair via OrgChartNode.parentEitherOrLinkId.
model OrgChartEitherOrLink {
  id        String       @id @default(cuid())
  nodeAId   String       @map("node_a_id")
  nodeBId   String       @map("node_b_id")
  nodeA     OrgChartNode @relation("EitherOrNodeA", fields: [nodeAId], references: [id], onDelete: Cascade)
  nodeB     OrgChartNode @relation("EitherOrNodeB", fields: [nodeBId], references: [id], onDelete: Cascade)
  children  OrgChartNode[] @relation("EitherOrChildren")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([nodeAId, nodeBId])
  @@index([nodeBId])
  @@map("org_chart_either_or_links")
}

/// Labeled grouping of org-chart people (e.g. Operations, Finance). Optional company scope.
/// Top-level departments may contain nested sub-departments at any depth via parentId,
/// or report to an individual org-chart person via reportsToNodeId.
model OrgChartSection {
  id            String           @id @default(cuid())
  name          String           @map("name")
  description   String?          @map("description")
  sortOrder     Int              @default(0) @map("sort_order")
  parentId      String?          @map("parent_id")
  parent        OrgChartSection? @relation("OrgChartSectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      OrgChartSection[] @relation("OrgChartSectionTree")
  companyTeamId String?          @map("company_team_id")
  companyTeam   Team?            @relation(fields: [companyTeamId], references: [id], onDelete: SetNull)
  /// Optional department head (must be an org-chart member).
  headNodeId    String?          @map("head_node_id")
  headNode      OrgChartNode?    @relation("OrgChartSectionHead", fields: [headNodeId], references: [id], onDelete: SetNull)
  /// Optional person this department reports to (instead of / in addition to a parent department).
  /// When set, the department chart hangs under that person; parentId should be null.
  reportsToNodeId String?        @map("reports_to_node_id")
  reportsToNode   OrgChartNode?  @relation("OrgChartSectionReportsTo", fields: [reportsToNodeId], references: [id], onDelete: SetNull)
  nodes         OrgChartNode[]
  memberships   OrgChartNodeSectionMembership[]
  roles         OrgChartSectionRole[]
  requestorTickets Ticket[] @relation("TicketRequestorSection")
  sendToTickets    Ticket[] @relation("TicketSendToSection")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([companyTeamId, sortOrder])
  @@index([parentId, sortOrder])
  @@index([headNodeId])
  @@index([reportsToNodeId])
  @@map("org_chart_sections")
}

/// Custom org roles defined for a section (e.g. Deputy, Coordinator, SME).
/// Distinct from the singleton section head (OrgChartSection.headNodeId).
model OrgChartSectionRole {
  id          String          @id @default(cuid())
  sectionId   String          @map("section_id")
  section     OrgChartSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label       String          @map("label")
  sortOrder   Int             @default(0) @map("sort_order")
  memberships OrgChartNodeSectionMembership[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([sectionId, label])
  @@index([sectionId, sortOrder])
  @@map("org_chart_section_roles")
}

/// Additional section memberships for a single org-chart member.
/// OrgChartNode.sectionId remains the primary section for backward-compatible labels.
model OrgChartNodeSectionMembership {
  id        String               @id @default(cuid())
  nodeId    String               @map("node_id")
  sectionId String               @map("section_id")
  roleId    String?              @map("role_id")
  node      OrgChartNode         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  section   OrgChartSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  role      OrgChartSectionRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt DateTime             @default(now()) @map("created_at")

  @@unique([nodeId, sectionId])
  @@index([sectionId])
  @@index([roleId])
  @@map("org_chart_node_section_memberships")
}

/// Company-scoped department (optional grouping for users and routing).
/// Logo columns are synced from HRIS: department logo when set, else parent company logo.
model Department {
  id                  String          @id @default(cuid())
  name                String          @map("name")
  companyTeamId       String          @map("company_team_id")
  companyTeam         Team            @relation(fields: [companyTeamId], references: [id], onDelete: Cascade)
  isActive            Boolean         @default(true) @map("is_active")
  /// HRIS departments.id when synced from merged/HRIS.
  hrisDepartmentId    BigInt?         @unique @map("hris_department_id")
  /// HRIS companies.id for the parent company (denormalized).
  hrisCompanyId       BigInt?         @map("hris_company_id")
  /// Relative path from HRIS departments.logo (usually null today).
  logoPath            String?         @map("logo_path")
  /// Relative path from HRIS companies.logo (company branding for this department).
  companyLogoPath     String?         @map("company_logo_path")
  /// Inlined data URL for display (department file preferred, else company logo).
  logoImage           String?         @map("logo_image") @db.Text
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  portalAccounts PortalAccount[]

  @@unique([companyTeamId, name])
  @@index([companyTeamId, isActive])
  @@index([hrisCompanyId])
  @@map("departments")
}

/// Catalog of business positions (RA/AP levels, RFP roles, etc.).
model Position {
  id          String   @id @default(cuid())
  code        String   @unique @map("code")
  name        String   @map("name")
  level       Int      @default(0) @map("level_rank")
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assignments               PositionAssignment[]
  primaryPortalAccounts     PortalAccount[] @relation("PortalPrimaryPosition")
  primaryOrgChartNodes      OrgChartNode[]  @relation("OrgChartPrimaryPosition")

  @@index([level, isActive])
  @@map("positions")
}

/// Who holds a position (optionally scoped by company). Supports acting assignments later.
model PositionAssignment {
  id                 String    @id @default(cuid())
  positionId         String    @map("position_id")
  position           Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  mergedSourceUserId String    @map("merged_source_user_id")
  companyTeamId      String?   @map("company_team_id")
  companyTeam        Team?     @relation(fields: [companyTeamId], references: [id], onDelete: SetNull)
  effectiveFrom      DateTime? @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  isActing           Boolean   @default(false) @map("is_acting")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([positionId, companyTeamId])
  @@index([mergedSourceUserId])
  @@map("position_assignments")
}

model Ticket {
  id                  String           @id @default(cuid())
  ticketNumber        String           @unique @map("ticket_number")
  title               String           @map("title")
  description         String           @map("description")
  category            TicketCategory   @map("category")
  /// Intake form kind: ISSUE_CONCERN_TICKET, REQUEST_FOR_PAYMENT, etc.
  requestType         String           @default("ISSUE_CONCERN_TICKET") @map("request_type")
  priority            TicketPriority   @default(LOW) @map("priority")
  status              TicketStatus     @default(OPEN) @map("status")
  /// Optional Request Board lane override (custom columns). Null → resolve from status.
  requestBoardColumnId String?         @map("request_board_column_id")
  requestBoardColumn   RequestBoardColumn? @relation(fields: [requestBoardColumnId], references: [id], onDelete: SetNull)
  /// When the ticket entered its current Request Board lane (status lane or custom column).
  boardLaneEnteredAt  DateTime         @default(now()) @map("board_lane_entered_at")
  contactName         String           @map("contact_name")
  contactEmail        String           @map("contact_email")
  requestorEmail      String?          @map("requestor_email")
  contactPhone        String?          @map("contact_phone")
  teamId              String?          @map("team_id")
  team                Team?            @relation(fields: [teamId], references: [id])
  /// RFP intake: requestor's org-chart section (Noted By roster scope).
  requestorOrgChartSectionId String?   @map("requestor_org_chart_section_id")
  requestorOrgChartSection   OrgChartSection? @relation("TicketRequestorSection", fields: [requestorOrgChartSectionId], references: [id], onDelete: SetNull)
  /// RFP intake: send-to org-chart section (Bookkeeper roster scope).
  orgChartSectionId   String?          @map("org_chart_section_id")
  orgChartSection     OrgChartSection? @relation("TicketSendToSection", fields: [orgChartSectionId], references: [id], onDelete: SetNull)
  assignedAgentId     String?          @map("assigned_agent_id")
  assignedAgent       Agent?           @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  firstResponseDueAt  DateTime         @map("first_response_due_at")
  resolutionDueAt     DateTime         @map("resolution_due_at")
  firstResponseAt     DateTime?        @map("first_response_at")
  resolvedAt          DateTime?        @map("resolved_at")
  closedAt            DateTime?        @map("closed_at")
  escalationType      EscalationType?  @map("escalation_type")
  escalatedAt         DateTime?        @map("escalated_at")
  reopenCount         Int              @default(0) @map("reopen_count")
  resolutionNotes     String?          @map("resolution_notes")
  /// Free-text remarks for the request (shown above audit trail; pinned for requestors at confirmation).
  remarks             String?          @map("remarks") @db.Text
  intakeScreenshotMeta Json?           @map("intake_screenshot_meta")
  /// Request-for-payment approval assignees + procedural step (JSON).
  paymentApprovalMeta Json?            @map("payment_approval_meta")
  /// Item requisition slip approval assignees + procedural step (JSON).
  itemRequisitionApprovalMeta Json?    @map("item_requisition_approval_meta")
  /// Fund transfer request approval assignees + procedural step (JSON).
  fundTransferApprovalMeta Json?       @map("fund_transfer_approval_meta")
  /// Authority to Conduct Activity approval assignees + procedural step (JSON).
  acaApprovalMeta Json?                @map("aca_approval_meta")
  /// Job Order approval assignees + procedural step (JSON).
  jobOrderApprovalMeta Json?           @map("job_order_approval_meta")
  /// Job Order (J.O.) → Task Board project link (`KpiMaintenance` with isProject).
  linkedKpiMaintenanceId String?       @map("linked_kpi_maintenance_id")
  linkedKpiMaintenance   KpiMaintenance? @relation("JobOrderProject", fields: [linkedKpiMaintenanceId], references: [id], onDelete: SetNull)
  /// Work Plan / Travel Order → Request for Payment link.
  linkedTravelOrderId String?          @map("linked_travel_order_id")
  linkedTravelOrder   TravelOrder?     @relation("TravelOrderRfp", fields: [linkedTravelOrderId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  activities          TicketActivity[]
  messages            TicketMessage[]
  chatMessages        ChatMessage[]
  feedback            TicketFeedback?

  @@index([linkedKpiMaintenanceId])
  @@index([linkedTravelOrderId])
  @@index([status, updatedAt])
  @@index([status, createdAt])
  @@index([requestBoardColumnId])
  @@index([boardLaneEnteredAt, status])
  @@index([contactEmail, updatedAt])
  @@index([contactEmail, createdAt])
  @@index([requestorEmail, updatedAt])
  @@index([requestorEmail, createdAt])
  @@index([assignedAgentId, status])
  @@index([assignedAgentId, createdAt])
  @@index([assignedAgentId, updatedAt])
  @@index([teamId, status])
  @@index([teamId, createdAt])
  @@index([orgChartSectionId])
  @@index([requestorOrgChartSectionId])
  @@index([resolutionDueAt, status])
  @@index([resolvedAt])
  @@index([closedAt])
  @@index([closedAt, assignedAgentId])
  @@index([createdAt])
  @@index([priority, status])
  @@index([status, priority, updatedAt])
  @@index([requestType])
  @@map("tickets")
}

model TicketActivity {
  id        String         @id @default(cuid())
  ticketId  String         @map("ticket_id")
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor     ActivityActor  @map("actor")
  summary   String         @map("summary")
  detail    String?        @map("detail")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@index([summary, createdAt])
  @@index([ticketId, summary, createdAt])
  @@map("ticket_activities")
}

model TicketMessage {
  id        String         @id @default(cuid())
  ticketId  String         @map("ticket_id")
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor     ActivityActor  @map("actor")
  author    String         @map("author")
  body      String         @map("body")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

/// Real-time request chat (one thread per ticket). Separate from legacy TicketMessage.
model ChatMessage {
  id          String            @id @default(cuid())
  ticketId    String            @map("ticket_id")
  ticket      Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Portal account id (session.user.id) of the sender.
  senderId    String            @map("sender_id")
  senderName  String            @map("sender_name")
  senderRole  String?           @map("sender_role")
  body        String            @map("body") @db.Text
  /// JSON array: [{ id, fileName, mimeType, sizeBytes, storedFileName }]
  attachments Json?             @map("attachments")
  /// First time another participant's client received the message (socket ack or history fetch).
  deliveredAt DateTime?         @map("delivered_at")
  /// True once at least one other participant has marked the message read.
  isRead      Boolean           @default(false) @map("is_read")
  readAt      DateTime?         @map("read_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  reads       ChatMessageRead[]

  @@index([ticketId, createdAt])
  @@index([senderId, createdAt])
  @@map("chat_messages")
}

model ChatMessageRead {
  id        String      @id @default(cuid())
  messageId String      @map("message_id")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  readerId  String      @map("reader_id")
  readAt    DateTime    @default(now()) @map("read_at")

  @@unique([messageId, readerId])
  @@index([readerId, readAt])
  @@map("chat_message_reads")
}

model TicketFeedback {
  id        String   @id @default(cuid())
  ticketId  String   @unique @map("ticket_id")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  csat      Int      @map("csat")
  nps       Int?     @map("nps")
  ces       Int?     @map("ces")
  comment   String?  @map("comment")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ticket_feedbacks")
}

model KpiMaintenance {
  id                   String       @id @default(cuid())
  title                String       @map("title")
  mainTask             String?      @map("main_task")
  isRecurring          Boolean      @default(true) @map("is_recurring")
  nonRecurringStartAt  DateTime?    @map("non_recurring_start_at")
  nonRecurringEndAt    DateTime?    @map("non_recurring_end_at")
  frequency            KpiFrequency @map("frequency")
  subKpis              Json         @map("sub_kpis")
  assignedAgentId      String?      @map("assigned_agent_id")
  assignedAgent        Agent?       @relation("AssignedKpi", fields: [assignedAgentId], references: [id])
  assignedRole         String?      @map("assigned_role")
  recurrenceWeekday    Int?         @map("recurrence_weekday")
  recurrenceMonthDay   Int?         @map("recurrence_month_day")
  periodCycleStartAt   DateTime?    @map("period_cycle_start_at")
  lastFullCompletionAt DateTime?    @map("last_full_completion_at")
  /// null | PENDING_VERIFICATION | VERIFIED | REJECTED — gate before board "Done".
  completionVerificationStatus String? @map("completion_verification_status")
  /// Optional designated verifier; falls back to creator / org-chart manager.
  verifierAgentId      String?      @map("verifier_agent_id")
  verifierAgent        Agent?       @relation("KpiCompletionVerifier", fields: [verifierAgentId], references: [id], onDelete: SetNull)
  pendingVerificationAt DateTime?   @map("pending_verification_at")
  verifiedAt           DateTime?    @map("verified_at")
  verifiedByAgentId    String?      @map("verified_by_agent_id")
  verifiedByAgent      Agent?       @relation("KpiCompletionVerifiedBy", fields: [verifiedByAgentId], references: [id], onDelete: SetNull)
  verificationRejectionComment String? @map("verification_rejection_comment") @db.Text
  periodKey            String?      @map("period_key")
  rolledOverIncomplete Boolean      @default(false) @map("rolled_over_incomplete")
  itProjectName        String?      @map("it_project_name")
  itProjectPhase       String?      @map("it_project_phase")
  scopedCompanyTeamId  String?      @map("scoped_company_team_id")
  /// When false, subtask assignee UI stays hidden until Seek Assistance unlocks a subtask.
  enableSubtaskAssignees Boolean    @default(true) @map("enable_subtask_assignees")
  createdBy            String       @map("created_by")
  createdByRole        String       @map("created_by_role")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  periodSnapshots      KpiMaintenancePeriodSnapshot[]
  activities           KpiMaintenanceActivity[]
  travelOrders         TravelOrder[]
  linkedJobOrderTickets Ticket[]    @relation("JobOrderProject")

  @@index([assignedAgentId, frequency])
  @@index([scopedCompanyTeamId])
  @@index([createdAt])
  @@index([completionVerificationStatus])
  @@index([verifierAgentId])
  @@unique([title, mainTask])
  @@map("kpi_maintenance")
}

model KpiMaintenanceActivity {
  id               String         @id @default(cuid())
  kpiMaintenanceId String         @map("kpi_maintenance_id")
  kpiMaintenance   KpiMaintenance @relation(fields: [kpiMaintenanceId], references: [id], onDelete: Cascade)
  author           String         @map("author")
  summary          String         @map("summary")
  detail           String?        @map("detail")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([kpiMaintenanceId, createdAt])
  @@map("kpi_maintenance_activities")
}

/// Field Assignment — Work Plan for Management Approval (legacy Travel Order rows kept readable).
model TravelOrder {
  id                 String                @id @default(cuid())
  kpiMaintenanceId   String                @map("kpi_maintenance_id")
  kpiMaintenance     KpiMaintenance        @relation(fields: [kpiMaintenanceId], references: [id], onDelete: Cascade)
  orderRequest       String                @map("order_request") @db.Text
  /// Work Plan for Management Approval structured fields (null = legacy Travel Order).
  workPlanMeta       Json?                 @map("work_plan_meta")
  /// Order-level supporting files (images + docs): [{ storedFileName, originalName, mimeType, size, uploadedAt }]
  attachments        Json                  @default("[]") @map("attachments")
  approvedByAgentId  String?               @map("approved_by_agent_id")
  approvedByAgent    Agent?                @relation("TravelOrderApprover", fields: [approvedByAgentId], references: [id], onDelete: SetNull)
  /// One or more designated approvers (agent ids). `approvedByAgentId` keeps the primary/first for legacy joins.
  approvedByAgentIds Json                   @default("[]") @map("approved_by_agent_ids")
  /// Ordered hierarchical approval chain. Empty = flat multi-approver mode.
  /// [{ level, agentId, approvedAt, approvedByAgentId }]
  approvalLevels     Json                   @default("[]") @map("approval_levels")
  /// Person who confirms the travel order while it is running (after approval).
  confirmationByAgentId String?            @map("confirmation_by_agent_id")
  confirmationByAgent   Agent?             @relation("TravelOrderConfirmer", fields: [confirmationByAgentId], references: [id], onDelete: SetNull)
  /// Requester / owner (auto-assigned on create).
  createdByAgentId   String?               @map("created_by_agent_id")
  createdByAgent     Agent?                @relation("TravelOrderCreator", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  /// Roster company (Team id) used for visibility and picker scoping.
  companyTeamId      String?               @map("company_team_id")
  /// Creator + co-travelers (agent ids). Always includes createdByAgentId when set.
  travelerAgentIds   Json                  @default("[]") @map("traveler_agent_ids")
  /// Vehicle used for the trip (preset option value, e.g. COMPANY_VAN).
  vehicle            String?               @map("vehicle")
  /// When true, a driver from the traveler list is designated with a license number.
  driverPresent      Boolean               @default(false) @map("driver_present")
  driverAgentId      String?               @map("driver_agent_id")
  driverAgent        Agent?                @relation("TravelOrderDriver", fields: [driverAgentId], references: [id], onDelete: SetNull)
  driverLicenseNo    String?               @map("driver_license_no")
  /// Required when status is REJECTED — why the approver/confirmer declined.
  rejectionReason    String?               @map("rejection_reason") @db.Text
  /// Who declined the order (approver or confirmer).
  rejectedByAgentId  String?               @map("rejected_by_agent_id")
  rejectedAt         DateTime?             @map("rejected_at") @db.Timestamptz(3)
  /// Approval level that declined (null = declined at confirmation after full approval).
  rejectedAtLevel    Int?                  @map("rejected_at_level")
  /// Field Assignment KPI % recorded on Submit as Done: (checked/total)*100.
  kpiPercent         Int?                  @map("kpi_percent")
  kpiSubmittedAt     DateTime?             @map("kpi_submitted_at") @db.Timestamptz(3)
  /// Optional Gate Pass page was filled (false when skipped).
  gatePassIncluded   Boolean               @default(false) @map("gate_pass_included")
  estDepartureAt     DateTime?             @map("est_departure_at") @db.Timestamptz(3)
  estArrivalAt       DateTime?             @map("est_arrival_at") @db.Timestamptz(3)
  /// Actual departure Start/End (same pattern as location visit).
  actualDepartureStartedAt        DateTime? @map("actual_departure_started_at") @db.Timestamptz(3)
  actualDepartureStartedLatitude  Float?    @map("actual_departure_started_latitude")
  actualDepartureStartedLongitude Float?    @map("actual_departure_started_longitude")
  actualDepartureEndedAt          DateTime? @map("actual_departure_ended_at") @db.Timestamptz(3)
  actualDepartureEndedLatitude    Float?    @map("actual_departure_ended_latitude")
  actualDepartureEndedLongitude   Float?    @map("actual_departure_ended_longitude")
  /// Guard on Duty name captured with Actual Departure Start / End.
  gatePassStartGuardOnDuty        String?   @map("gate_pass_start_guard_on_duty")
  gatePassEndGuardOnDuty          String?   @map("gate_pass_end_guard_on_duty")
  status             String                @default("SUBMITTED") @map("status")
  createdBy          String                @map("created_by")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  locations          TravelOrderLocation[]
  linkedRfpTickets   Ticket[]              @relation("TravelOrderRfp")

  @@index([kpiMaintenanceId, createdAt])
  @@index([approvedByAgentId])
  @@index([confirmationByAgentId])
  @@index([createdByAgentId])
  @@index([companyTeamId])
  @@map("travel_orders")
}

model TravelOrderLocation {
  id            String      @id @default(cuid())
  travelOrderId String      @map("travel_order_id")
  travelOrder   TravelOrder @relation(fields: [travelOrderId], references: [id], onDelete: Cascade)
  /// Location name / address label.
  label         String      @map("label")
  /// Legacy / End GPS pin (kept in sync with ended_* when ending a visit).
  latitude      Float?      @map("latitude")
  longitude     Float?      @map("longitude")
  /// Legacy end timestamp (kept in sync with ended_at).
  checkedAt     DateTime?   @map("checked_at") @db.Timestamptz(3)
  /// Start visit GPS + time (null until Start is pressed).
  startedAt        DateTime? @map("started_at") @db.Timestamptz(3)
  startedLatitude  Float?    @map("started_latitude")
  startedLongitude Float?    @map("started_longitude")
  /// End visit GPS + time (null until End is pressed).
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(3)
  endedLatitude    Float?    @map("ended_latitude")
  endedLongitude   Float?    @map("ended_longitude")
  remarks       String?     @map("remarks") @db.Text
  /// Image attachment meta: [{ storedFileName, originalName, mimeType, size, uploadedAt }]
  attachments   Json?       @map("attachments")
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([travelOrderId, sortOrder])
  @@map("travel_order_locations")
}

model KpiMaintenancePeriodSnapshot {
  id               String         @id @default(cuid())
  kpiMaintenanceId String         @map("kpi_maintenance_id")
  kpiMaintenance   KpiMaintenance @relation(fields: [kpiMaintenanceId], references: [id], onDelete: Cascade)
  periodKey        String         @map("period_key")
  frequency        KpiFrequency   @map("frequency")
  timeZone         String         @map("time_zone")
  total            Int            @map("total")
  done             Int            @map("done")
  missing          Int            @map("missing")
  percent          Int            @map("percent")
  fullyComplete    Boolean        @default(false) @map("fully_complete")
  contributorProgress Json?       @map("contributor_progress")
  capturedAt       DateTime       @default(now()) @map("captured_at")

  @@unique([kpiMaintenanceId, periodKey])
  @@index([periodKey])
  @@index([kpiMaintenanceId, capturedAt])
  @@map("kpi_maintenance_period_snapshots")
}

model HelpdeskCsvTicket {
  id               String    @id @default(cuid())
  sheetRowId       String    @unique @map("sheet_row_id")
  reportedAt       DateTime  @map("reported_at")
  resolvedAt       DateTime? @map("resolved_at")
  statusRaw        String    @map("status_raw")
  normalizedBucket String    @map("normalized_bucket")
  userEmail        String?   @map("user_email")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([reportedAt])
  @@index([resolvedAt])
  @@index([normalizedBucket, reportedAt])
  @@map("helpdesk_csv_tickets")
}

model TaskItem {
  id                   String      @id @default(cuid())
  title                String      @map("title")
  description          String?     @map("description")
  status               TaskStatus  @default(CURRENT) @map("status")
  assignedAgentId      String?     @map("assigned_agent_id")
  assignedAgent        Agent?      @relation("AssignedTask", fields: [assignedAgentId], references: [id])
  priority             String?     @map("priority")
  dueAt                DateTime?   @map("due_at")
  /// When the assignee started work (Start Task).
  startedAt            DateTime?   @map("started_at")
  /// When the task was completed (End Task). Prefer over updatedAt for efficiency.
  completedAt          DateTime?   @map("completed_at")
  /// Points deducted per penalty period (day/week/month per frequency).
  delayPenaltyAmount   Int?        @map("delay_penalty_amount")
  /// Cached accrued delay penalty points for display.
  delayPenaltyAccrued  Int         @default(0) @map("delay_penalty_accrued")
  /// Accrual cadence for delayPenaltyAmount (default DAILY preserves legacy math).
  delayPenaltyFrequency DelayPenaltyFrequency @default(DAILY) @map("delay_penalty_frequency")
  createdBy            String      @map("created_by")
  createdByRole        String      @map("created_by_role")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  activities           TaskActivity[]

  @@index([assignedAgentId, status])
  @@index([status, dueAt])
  @@index([createdAt])
  @@map("task_items")
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  task      TaskItem @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    String   @map("author")
  action    String   @map("action")
  detail    String?  @map("detail")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("task_activities")
}

model AccountActionRequest {
  id              String   @id @default(cuid())
  portalAccountId String   @map("portal_account_id")
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  requestType     String   @map("request_type")
  reason          String?  @map("reason")
  status          String   @default("PENDING") @map("status")
  reviewedBy      String?  @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([portalAccountId, createdAt])
  @@index([status, createdAt])
  @@map("account_action_requests")
}

/// Changelog / release notes shown in the header Patch Notes modal.
model PatchNote {
  id         String              @id @default(dbgenerated("gen_random_uuid()::text"))
  version    String
  title      String
  /// e.g. { "newFeatures": [...], "bugFixes": [...], "improvements": [...] }
  content    Json
  releasedAt DateTime            @default(now())
  createdAt  DateTime            @default(now())
  views      UserPatchNoteView[]

  @@index([releasedAt])
  @@map("PatchNote")
}

/// Tracks which merge-DB users have read a given patch note.
model UserPatchNoteView {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  /// MergeDatabase merged_users.source_user_id (as text).
  userId      String
  patchNoteId String
  patchNote   PatchNote @relation(fields: [patchNoteId], references: [id], onDelete: Cascade)
  viewedAt    DateTime  @default(now())

  @@unique([userId, patchNoteId])
  @@index([userId])
  @@map("UserPatchNoteView")
}

/// Key/value JSON settings for platform-wide SuperAdmin configuration.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("platform_settings")
}

/// Customizable Request Board lanes (legacy global seed/template).
/// Live board UI now uses per-user layouts in `request_board_user_layouts`.
model RequestBoardColumn {
  id             String       @id @default(cuid())
  name           String       @map("name")
  sortOrder      Int          @map("sort_order")
  isDefault      Boolean      @default(false) @map("is_default")
  /// Status written when a card is dropped into this lane.
  mappedStatus   TicketStatus @map("mapped_status")
  /// Optional display label for the mapping (e.g. "On Delivery"). Null → use mappedStatus label.
  mappingLabel   String?      @map("mapping_label")
  /// Statuses that appear here when ticket.requestBoardColumnId is null (JSON string array).
  acceptStatuses Json         @map("accept_statuses")
  /// When false, cards cannot be dropped into this lane (default Open).
  allowDrop      Boolean      @default(true) @map("allow_drop")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  tickets        Ticket[]

  @@index([sortOrder])
  @@map("request_board_columns")
}

/// Per-account Request Board column layout (names, order, personal custom boards).
model RequestBoardUserLayout {
  id        String   @id @default(cuid())
  ownerKey  String   @unique @map("owner_key")
  columns   Json     @map("columns")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("request_board_user_layouts")
}
