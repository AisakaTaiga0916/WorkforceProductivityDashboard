# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example
!.env.restore.example

# pm2
/logs
/.pm2
/.pm2-runtime
/logs/server.pid

# user-uploaded ticket screenshots (served via /api/tickets/[id]/screenshots/...)
/uploads

# local DB dumps / JSON backups — never commit
/backups

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# vendored binaries (download from upstream instead of committing)
tools/cloudflared.exe

# generated migration reports (regenerate with the classify script)
/scripts/projects-migration-dry-run.csv
